```{=html}
<div class="research project-list">
<ul class="list">
    <% for (const item of items) { %>
    <li class="project" <%= metadataAttrs(item) %> data-listing-categories="<%= item.categories ? item.categories.join(',') : '' %>">
        <article>
            <p class="project-title">
                <a href="<%- item.path %>"><%= item.title %></a>
            </p>

            <% if (item['pub-info']) { %>
            <div class="project-content listing-pub-info">
                <% if (item['pub-info'].authors) { %>
                <p class="listing-authors"><%= item['pub-info'].authors %></p>
                <% } %>
                <% if (item['pub-info'].venue) { %>
                <p class="listing-venue"><%= item['pub-info'].venue %></p>
                <% } %>
            </div>
            <% } %>

            <% if (item['listing-summary'] !== false && item.description && String(item.description).trim()) { %>
            <p class="project-summary"><%= item.description %></p>
            <% } %>

            <% if (item.categories) { %>
            <div class="project-categories" role="group" aria-label="Research topics">
                <% for (const cat of item.categories) { %>
                <div class="project-category">
                    <button type="button" class="category-filter" data-category="<%= cat %>" aria-pressed="false"><%= cat %></button>
                </div>
                <% } %>
            </div>
            <% } %>

            <% if (item['pub-info'] && item['pub-info'].links) { %>
            <div class="project-details-listing">
                <ul class="project-links">
                    <% for (const link of item['pub-info'].links) { %>
                    <li class="project-link">
                        <% if (link.local) { %>
                        <a href="<%- item.path.substring(0, item.path.lastIndexOf('/')) %>/<%- link.url %>">
                        <% } else { %>
                        <a href="<%- link.url %>">
                        <% } %>
                            <i class="<%- link.icon %>" aria-hidden="true"></i> <%= link.name %>
                        </a>
                    </li>
                    <% } %>
                </ul>
            </div>
            <% } %>
        </article>
    </li>
    <% } %>
</ul>
</div>
```